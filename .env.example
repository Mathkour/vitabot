# Copy this file to ".env" (same folder as main.py) and fill in real values.
# The backend imports all AI clients at startup, so the keys below are REQUIRED
# or the app will fail to start.

# Used for chat/answer generation, translations, OCR/vision, and the Odoo agent
# (services/llm.py, services/odoo_agent.py, services/import_users.py).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used for embeddings (services/embeddings.py) and TTS/transcription
# (services/tts.py). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Required. JWT signing secret — the app refuses to start without a real value
# here (core/config.py). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional, defaults to 30 if unset.
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required. PostgreSQL connection string (read by db.py at startup).
# Point it at the server where database/cpbot_backup.dump was restored.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cpbot2

# Optional. Only needed for the superadmin GET /odoo/dashboard endpoint
# (services/odoo_service.py). If unset/unreachable, that endpoint returns a
# 503 instead of failing app startup.
ODOO_URL=http://localhost:8069
ODOO_DB=your-odoo-db-name
ODOO_USERNAME=your-odoo-username
ODOO_PASSWORD=your-odoo-password

# Required for POST /auth/odoo-sso when the request has no client_key — i.e.
# Vita Care's own internal Odoo instance (every external client has their
# OWN separate secret instead, stored encrypted in odoo_client_connections,
# set via scripts/prep_client_insert.py — see migrations/012).
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# cpbot_vita_bot_link's Settings > General Settings > Vita Bot "SSO Secret"
# field must hold this same value, used there as an HMAC signing key (not
# sent as a bare header) — see controllers/sso.py.
ODOO_SSO_INTERNAL_SECRET=generate-a-long-random-value-here

# Required for POST /analytics/digest-run (per-tenant analytics digest,
# meant to be called by an external scheduler, e.g. a Render Cron Job).
# Generate the same way as ODOO_SSO_INTERNAL_SECRET; the caller sends it in
# the X-Analytics-Digest-Secret header.
ANALYTICS_DIGEST_SECRET=generate-a-long-random-value-here

# Required for encrypting/decrypting odoo_client_connections.odoo_password_encrypted
# (per-client Odoo credentials for multi-tenant Ask Odoo). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key makes any already-encrypted passwords undecryptable.
CLIENT_CREDENTIALS_ENCRYPTION_KEY=generate-a-fernet-key-here

# --- File storage (Cloudinary) ---
# Uploaded documents and media are stored on Cloudinary so they survive
# redeploys/restarts (Render's local disk is ephemeral). If these are unset,
# the app falls back to local disk under uploads/ (fine for local dev, but
# files WILL be lost on the next deploy). Find these on your Cloudinary
# dashboard home page.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional. Top-level folder all uploads are nested under (default: cpbot).
# CLOUDINARY_FOLDER=cpbot

# --- CORS (which frontend domains may call this backend) ---
# Both optional; each falls back to the current hardcoded default if unset.
# Set these when deploying to a new domain instead of editing main.py.
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:4200
# CORS_ALLOWED_ORIGIN_REGEX=https://([a-z0-9-]+\.)*(example\.com)

# --- Embeddable chat widget (per-tenant SSO) ---
# Slug is the tenant name the partner passes to the widget, uppercased.
# Generate the secret with: openssl rand -base64 48   (must be >= 32 chars)
WIDGET_CREDITPLUS_TENANT_ID=<tenants.id of Credit Plus>
WIDGET_CREDITPLUS_JWT_SECRET=<shared HS256 secret, given to Credit Plus out-of-band>
# Origins allowed to call /widget/* from the browser (comma separated)
WIDGET_ALLOWED_ORIGINS=https://credit-plus.me,https://www.credit-plus.me
