<?xml version="1.0" encoding="utf-8"?>
<!--
  Backend (FastAPI) site config - REVERSE PROXY mode.
  IIS terminates HTTPS for the backend host (e.g. bot-api.credit-plus.me) and forwards
  every request to Uvicorn running on 127.0.0.1:8000.

  Requires:
    * URL Rewrite + Application Request Routing (ARR), with ARR proxy ENABLED at the
      server level  -> Setup-ReverseProxy.ps1 installs both and enables it.
    * Uvicorn actually listening on the port below
      -> Install-BackendService.ps1 keeps it running as a startup task.

  This file does NOT use HttpPlatformHandler - in reverse-proxy mode IIS does not launch Python.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="CP_BOT reverse proxy to Uvicorn" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- allow large file uploads (200 MB) for /documents/upload and /media/upload -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
