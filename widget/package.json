{
  "name": "cpbot-widget",
  "version": "1.0.0",
  "description": "Embeddable floating chat widget for cpbot (framework-agnostic, no runtime dependencies)",
  "license": "UNLICENSED",
  "private": false,
  "main": "dist/cpbot-widget.js",
  "module": "dist/cpbot-widget.esm.mjs",
  "unpkg": "dist/cpbot-widget.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cpbot-widget.esm.mjs",
      "require": "./dist/cpbot-widget.js"
    }
  },
  "files": [
    "dist",
    "INTEGRATION.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build && node scripts/copy-types.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
