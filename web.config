<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the FastAPI backend (api.<domain>).
  IIS does not run Python; HttpPlatformHandler launches Uvicorn and reverse-proxies
  requests to it on the port IIS assigns via %HTTP_PLATFORM_PORT%.

  Requirements on the IIS side (handled by deploy/Install-IIS.ps1):
    * HttpPlatformHandler module installed
    * This folder (C:\Work\CP_BOT) is the backend site's physical path
    * The site's app pool is set to "No Managed Code"
    * The app pool identity has read+execute on this folder and the .venv,
      and write on .\uploads and .\logs
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Work\CP_BOT\.venv\Scripts\python.exe"
                  arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\Work\CP_BOT\logs\backend-stdout"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONPATH" value="C:\Work\CP_BOT" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
